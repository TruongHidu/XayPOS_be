# Copy to deploy/.env and fill in. deploy/.env is git-ignored — never commit it.

# Domain pointing (DNS A record) to the VPS IP. Caddy issues HTTPS for it.
DOMAIN=pos.example.com
# Optional: override what Caddy listens on, e.g. ":80" to test over plain HTTP by IP.
# SITE_ADDRESS=:80

# ---- PostgreSQL ----
POSTGRES_DB=pos_saas
POSTGRES_USER=pos_saas
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- Security ----
# Generate: openssl rand -base64 48   (must be at least 32 bytes)
JWT_SECRET=

# First start only: creates the super admin account, then set back to false.
SUPER_ADMIN_BOOTSTRAP_ENABLED=true
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=System Administrator

# ---- Cloudinary (image upload) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pos-saas

# ---- Subscription purchase / SePay ----
SUBSCRIPTION_PURCHASE_ACCEPT_NEW=false
SEPAY_ENABLED=false
SEPAY_PROVIDER_ACCOUNT_KEY=
SEPAY_BANK_CODE=
SEPAY_BANK_BIN=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=

# ---- Memory tuning (defaults suit a 2 GB VPS; for 4 GB use 1536m / 1g / 768m) ----
# BACKEND_MEM_LIMIT=1g
# PG_MEM_LIMIT=512m
# PG_SHARED_BUFFERS=256MB

# Frontend repo location relative to this folder.
# FE_DIR=../../pos-saas-web
