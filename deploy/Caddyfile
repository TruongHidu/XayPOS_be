# Đứng sau Caddy edge (/opt/edge-proxy): tin X-Forwarded-For/Proto do edge (IP nội bộ Docker)
# gửi tới, để backend vẫn thấy IP thật của khách và biết request gốc là https.
{
	servers {
		trusted_proxies static private_ranges
	}
}

# SITE_ADDRESS = ":80" khi chạy sau Caddy edge (HTTPS do edge lo).
# Chạy độc lập không có edge thì đặt SITE_ADDRESS là domain để Caddy tự cấp SSL.
{$SITE_ADDRESS} {
	encode zstd gzip

	# REST API, SePay webhook and STOMP WebSocket go to Spring Boot.
	@backend path /api/* /ws /ws/*
	handle @backend {
		reverse_proxy backend:8080
	}

	# Everything else is the React SPA.
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}